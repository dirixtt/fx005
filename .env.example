# Supabase — project settings > API.
# Both are public: the anon key is safe in the browser because every table is
# gated by Row Level Security and writes go through SECURITY DEFINER functions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin, no trailing slash. Used for sitemap.xml, robots.txt
# and Open Graph URLs.
#
# OPTIONAL on Vercel: when unset, the app uses the project's free
# *.vercel.app production domain, which Vercel injects into the build
# automatically. Only set this once you point a custom domain at the shop.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Low-stock Telegram alert (/api/cron/low-stock, scheduled in vercel.json).
# CRON_SECRET is required: without it the route refuses to run, so nobody can
# trigger alerts or read your stock levels by hitting the URL.
CRON_SECRET=generate-a-long-random-string
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# TELEGRAM_CHAT_ID is gone as of the multi-tenant pivot: alerts now go to
# shop_info.notify_chat_id, set per store by each seller linking their own
# Telegram account on /admin/settings/telegram — not a single global chat.

# --- Telegram Business assistant ---

# Service-role key. The FIRST genuine server-side secret in this project, and it
# must never reach the browser. Only /api/telegram/webhook uses it: inbound
# customer messages have to be written with RLS bypassed, and the alternative — a
# SECURITY DEFINER insert reachable with the public anon key — would let anyone
# forge customer conversations and fake orders.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token on every
# webhook call. Set it when registering the webhook; the route rejects anything
# that does not match, which is what stops the endpoint being world-callable.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# Intent recognition. The model only ever selects a function and its arguments —
# stock levels and prices come from the database, never from the model.
#
# Without this key the assistant does not answer at all: every message falls
# through to "stay silent, the seller will handle it", which is the same
# behaviour the shop had before the bot existed. Nothing breaks, it just goes
# quiet.
ANTHROPIC_API_KEY=sk-ant-...

# --- Unanswered-conversation reminders ---
#
# No new variable. The reminder route (/api/cron/unanswered) reuses CRON_SECRET
# above, and runs once per active store, alerting each store's own
# shop_info.notify_chat_id.
#
# It is scheduled from Postgres, not vercel.json, because the Vercel Hobby plan
# allows one cron run per day and a "customer waiting" alert is worthless the
# next morning. pg_cron calls the route every five minutes and reads the URL and
# secret from Supabase Vault — run this ONCE per environment in the SQL editor,
# with cron_secret set to the same value as CRON_SECRET above:
#
#   select vault.create_secret('https://your-shop.vercel.app', 'site_url');
#   select vault.create_secret('<same value as CRON_SECRET>', 'cron_secret');
#
# Until both exist the job runs, warns, and does nothing.
