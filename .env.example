# Supabase — project settings > API.
# Both are public: the anon key is safe in the browser because every table is
# gated by Row Level Security and writes go through SECURITY DEFINER functions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical public origin, no trailing slash. Used for sitemap.xml, robots.txt
# and Open Graph URLs.
#
# OPTIONAL on Vercel: when unset, the app uses the project's free
# *.vercel.app production domain, which Vercel injects into the build
# automatically. Only set this once you point a custom domain at the shop.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Low-stock Telegram alert (/api/cron/low-stock, scheduled in vercel.json).
# CRON_SECRET is required: without it the route refuses to run, so nobody can
# trigger alerts or read your stock levels by hitting the URL.
CRON_SECRET=generate-a-long-random-string
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# --- Telegram Business assistant ---

# Service-role key. The FIRST genuine server-side secret in this project, and it
# must never reach the browser. Only /api/telegram/webhook uses it: inbound
# customer messages have to be written with RLS bypassed, and the alternative — a
# SECURITY DEFINER insert reachable with the public anon key — would let anyone
# forge customer conversations and fake orders.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret echoed by Telegram in X-Telegram-Bot-Api-Secret-Token on every
# webhook call. Set it when registering the webhook; the route rejects anything
# that does not match, which is what stops the endpoint being world-callable.
TELEGRAM_WEBHOOK_SECRET=generate-a-long-random-string

# Intent recognition. The model only ever selects a function and its arguments —
# stock levels and prices come from the database, never from the model.
ANTHROPIC_API_KEY=sk-ant-...
